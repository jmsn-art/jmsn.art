# Copy to .env.local. Never commit your key. Restart the app after changing it.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TEXT_MODEL=gpt-4.1-mini
PORT=4317
# Optional absolute directory. Defaults to ./data
# STUDIO_DATA_DIR=
# Optional: read-only Git inspection and downloadable website handoff package.
# The studio never writes into this repository or publishes it.
# JMSN_ART_PATH=/absolute/path/to/jmsn.art
